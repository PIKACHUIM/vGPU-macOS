<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>vgpuFramebuffer</string>
	<key>CFBundleIdentifier</key>
	<string>com.vgpu.framebuffer</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>vgpuFramebuffer</string>
	<key>CFBundlePackageType</key>
	<string>KEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1.0.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>vgpuFramebuffer</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>com.vgpu.framebuffer</string>
			<key>IOClass</key>
			<string>vgpuFramebuffer</string>
			<!-- IOMatchCategory decides who wins when two drivers match the same device.
			     IONDRVFramebuffer already sits on display@F and provides the console, so
			     using the same category would evict it -- and a system with no console
			     device is not something to try on the first run. A distinct category lets
			     both attach: the boot-provided framebuffer keeps the screen, and this kext
			     starts alongside it and reports what it can see.

			     What makes IOGraphicsFamily treat this as a framebuffer is the IOFramebuffer
			     base class, not this string, so nothing is lost by not claiming the name.

			     Once coexistence is confirmed, the step after this is to claim IOFramebuffer
			     and return true from isConsoleDevice() so the window server renders here. -->
			<key>IOMatchCategory</key>
			<string>com.vgpu.framebuffer</string>
			<key>IOProbeScore</key>
			<integer>0</integer>
			<!-- Vendor 0x15AD, device 0x0405 = VMware SVGA II, which on this guest is the
			     IORegistry node display@F. This is the device that actually drives the
			     screen, so it is the only sensible place for a framebuffer to attach.

			     What is already there matters. This guest has no graphics kext at all --
			     system_profiler reports "No Kext Loaded" -- because the display is driven by
			     IONDRVFramebuffer, which boot.efi installs through the legacy NDRV mechanism
			     rather than through an IOKit match. So there is no other kext to contend
			     with; the open question is whether a kext-supplied framebuffer can coexist
			     with that boot-provided one.

			     Measured on this guest, from ioreg:
			       display@F   vendor-id 0x15ad   device-id 0x0405
			       BAR1 = 0xf0000000, length 0x08000000 (128 MB)  <- SVGA VRAM
			       IONDRVFramebuffer sits below display@F, AppleDisplay below that,
			       IODisplayPrefsKeyOld = .../display@F/.Display_boot/display0/AppleDisplay-...

			     The previous revision matched IOResources instead. That does start, but it
			     is a placeholder: IOResources is the root IOKit resource object, so the
			     framebuffer would probe at the earliest possible moment and could never
			     reach the real VRAM. -->
			<key>IOProviderClass</key>
			<string>IOPCIDevice</string>
			<key>IOPCIMatch</key>
			<string>0x040515AD</string>
		</dict>
	</dict>
	<key>OSBundleLibraries</key>
	<dict>
		<!-- IOGraphicsFamily must be listed. OSDefineMetaClassAndStructors makes our
		     metaclass point at IOFramebuffer's, and the collection builder only searches
		     libraries we have named. Omitting it fails with:
		       Cannot find symbol for metaclass pointed to by
		       '__ZN15vgpuFramebuffer10superClassE'. Expected symbol
		       '__ZN13IOFramebuffer10gMetaClassE' to be defined in another kext

		     Note the asymmetry in how that surfaces:
		       kextutil -v <kext>   -> Code=31 with the message above (useful)
		       kmutil load -z -p    -> Code=28 "requires a reboot" (message swallowed)
		     kextutil is a thin wrapper over `kmutil load --bundle-path`, so when a load
		     seems to "just need a reboot", re-run it through kextutil for the real error. -->
		<key>com.apple.iokit.IOGraphicsFamily</key>
		<string>1.0.0b1</string>
		<key>com.apple.kpi.iokit</key>
		<string>12.0.0</string>
		<key>com.apple.kpi.libkern</key>
		<string>12.0.0</string>
		<key>com.apple.kpi.mach</key>
		<string>12.0.0</string>
	</dict>
</dict>
</plist>
